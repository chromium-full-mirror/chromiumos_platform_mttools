{
  "manifest_version": 2,

  "name": "Feedback Touch Log Viewer",
  "description": "Adds a button on Google feedback pages to view touch logs.",
  "icons": {
    "128": "icon128.png",
    "48": "icon48.png",
    "16": "icon16.png"
  },
  "version": "1.0.5",

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["https://feedback.corp.google.com/*"],
      "js": ["report.js"]
    }
  ],
  "permissions": [
    "https://feedback.corp.google.com/*",
    "https://feedback.corp.googleusercontent.com/*",
    "storage"
  ]
}
